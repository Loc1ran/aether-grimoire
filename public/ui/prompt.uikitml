<style>
  .root { flex-direction: column; width: 64; padding-top: 2; padding-right: 2.4; padding-bottom: 2; padding-left: 2.4; background-color: #100e1c; border-color: #9f7ac7; border-width: 0.12; border-radius: 1.2; gap: 1; }
  .eyebrow { color: #cdb280; font-size: 1.2; font-weight: 700; }
  .title { color: #f3e9dc; font-size: 3; font-weight: 700; }
  .body { color: #ded5ed; font-size: 1.5; }
  .status { color: #c5a8f5; font-size: 1.25; }
  .row { flex-direction: row; gap: 1; }
  .button { background-color: #342743; color: #f3e9dc; font-size: 1.3; padding-top: 0.8; padding-right: 1.2; padding-bottom: 0.8; padding-left: 1.2; border-radius: 0.5; }
  .primary { background-color: #c6a976; color: #17111e; }
  .help { color: #a39bb5; font-size: 1.05; }
  .meter { width: 100%; height: 0.5; background-color: #302838; border-radius: 0.2; }
</style>
<div id="training-panel" class="root">
  <span class="eyebrow">AETHER / THE SPELLWRIGHT'S TRIAL</span>
  <span id="title" class="title">The Umbral Grimoire</span>
  <span id="body" class="body">Raise a hand near your chest. Pinch, hold, then pull upward to summon.</span>
  <span id="status" class="status">DORMANT / MANA 100</span>
  <span id="boss" class="status">OBSIDIAN WARDEN / Start trial</span>
  <div class="meter"><div id="boss-fill" style="width: 100%; height: 0.5; background-color: #d47787" /></div>
  <span id="resolve" class="status">RESOLVE 0 / 100</span>
  <div class="meter"><div id="resolve-fill" style="width: 0%; height: 0.5; background-color: #c29bf5" /></div>
  <div class="row">
    <button id="summon-button" class="button primary">Summon</button>
    <button id="xr-button" class="button">Enter VR</button>
    <button id="exit-button" class="button" style="display: none">Leave VR</button>
    <button id="emitter-button" class="button">Start trial</button>
  </div>
  <div class="row">
    <button id="attribute-button" class="button">Magic: Shadow</button>
    <button id="hand-button" class="button">Right handed</button>
    <button id="reset-button" class="button">Reset trial</button>
  </div>
  <span id="hint" class="help">Pinch and lift at your chest. Trigger and grip, or G.</span>
  <span id="debug" class="help">Hands: waiting for tracking</span>
</div>
